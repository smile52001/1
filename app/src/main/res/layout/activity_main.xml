<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="24dp"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="BLE 广播测试器" android:textSize="26sp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/status" android:text="状态：未开始"
        android:textSize="18sp" android:layout_marginTop="24dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/name" android:hint="广播名称" android:text="BLE-Test"
        android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/start" android:text="开始 BLE 广播"
        android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/stop" android:text="停止广播"
        android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="仅使用手机内置蓝牙 BLE 广播，不连接外部设备。" 
        android:layout_marginTop="28dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
